# same binning, but one genotype at a time
bin_one <- function(mask) {
  binf <- factor(bin[mask], levels = 1:n_bins)
  ind  <- Matrix::sparseMatrix(i = seq_along(binf), j = as.integer(binf), x = 1,
                               dims = c(length(binf), n_bins))
  m <- as.matrix(z[, mask, drop = FALSE] %*% ind)
  m <- sweep(m, 2, as.numeric(table(binf)), "/")
  m[is.nan(m)] <- NA
  m[, bins_to_keep, drop = FALSE]       
}

binned_mut <- bin_one(DNMT3A == "MUT")
binned_wt  <- bin_one(DNMT3A == "WT")
rm(z); gc()

# 1. z-scoring based on all mut and wt so figs are visually comparable
combined <- cbind(binned_mut, binned_wt)
mu  <- rowMeans(combined, na.rm = TRUE)
sdv <- apply(combined, 1, sd, na.rm = TRUE)
sdv[sdv == 0 | is.na(sdv)] <- 1
zscore <- function(m) {
  zb <- (m - mu) / sdv
  zb[!is.finite(zb)] <- 0
  zb
}
zb_mut <- zscore(binned_mut)
zb_wt  <- zscore(binned_wt)
zb_combined <- cbind(zb_mut, zb_wt)

